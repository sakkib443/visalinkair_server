# Dependencies & build output (reinstalled/rebuilt inside the image)
node_modules
dist

# Local uploads — production serves these from a mounted volume, and baking them
# in would both bloat the image and shadow the volume's contents.
uploads

# Secrets — never bake into the image (provided via Coolify env vars)
.env
.env.*

# VCS / editor / logs / docs
.git
.gitignore
.vscode
*.log
dev_server.log
README.md
